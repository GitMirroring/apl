// rval.def — ⎕RVAL parameters for invariant testcase generation
//
// Each non-comment, non-blank line is a prim_def() macro call with 5 arguments.
// The first and last are quoted C strings (they may contain APL commas).
// The middle three are unquoted; the macro uses # to stringify them.
// An empty A_stim or X_stim argument stands for ⍬ (⍬ cannot appear unquoted
// in GCC's preprocessor; prim_table_value() substitutes "" back to "⍬").
//
//   prim_def("arity", B_stim, A_stim, X_stim, "Z_constraint")
//
//   arity        APL expression, e.g. "Z←A⍴B"
//   B_stim       ⎕RVAL argument that generates the right (or only) argument B
//   A_stim       ⎕RVAL argument that generates the left argument A  (empty = ⍬)
//   X_stim       ⎕RVAL argument that generates the axis X            (empty = ⍬)
//   Z_constraint APL boolean expression (in terms of A B X Z) that must be 1
//
// ⎕RVAL B layout:  rank  shape  (types)  depth  ecount
//   rank   ¯N          random 0..N
//          (w0 w1 …)   weighted distribution over ranks 0,1,2,…
//   shape  ¯N          each axis random 0..N (scalar-extended to MAX_RANK)
//   types  (char int float complex nested)   boolean mask; 0 = type excluded
//   depth  max nesting depth (0 = simple arrays only)
//   ecount RE = run-time ravel-element limit (replaced by caller); 0 = unlimited
//
// Type masks use 0/1 only, so an external distribution DIST can be applied as
//   DIST × (1 1 1 1 0)
// to select both the per-type weights and the primitive's type constraints.
// depth=3 is kept even when nested=0; it only limits recursion when
// nested>0 is actually set.
//
// RE is a placeholder for the maximum ⍴∈ limit; the APL test runner
// substitutes a concrete value (e.g. 10000) before calling ⎕RVAL.
//
// One blank line separates different primitives.
//
// 6 ⎕RVAL ⍬  returns this table as a 5-column nested character matrix.

// ── + Conjugate / Plus ────────────────────────────────────────────────
prim_def("Z←+B", ¯3 ¯100 (0 1 1 1 0) 3 RE, , , "(⍴Z)≡⍴B")
prim_def("Z←A+B", ¯3 ¯100 (0 1 1 1 0) 3 RE, ~B, , "(⍴Z)≡⍴B")

// ── - Negate / Minus ──────────────────────────────────────────────────
prim_def("Z←-B", ¯3 ¯100 (0 1 1 1 0) 3 RE, , , "(⍴Z)≡⍴B")
prim_def("Z←A-B", ¯3 ¯100 (0 1 1 1 0) 3 RE, ~B, , "(⍴Z)≡⍴B")

// ── × Signum / Times ──────────────────────────────────────────────────
prim_def("Z←×B", ¯3 ¯100 (0 1 1 1 0) 3 RE, , , "(⍴Z)≡⍴B")
prim_def("Z←A×B", ¯3 ¯100 (0 1 1 1 0) 3 RE, ~B, , "(⍴Z)≡⍴B")

// ── ÷ Reciprocal / Divide ─────────────────────────────────────────────
prim_def("Z←÷B", ¯3 ¯100 (0 1 1 1 0) 3 RE, , , "(⍴Z)≡⍴B")
prim_def("Z←A÷B", ¯3 ¯100 (0 1 1 1 0) 3 RE, ~B, , "(⍴Z)≡⍴B")

// ── ⌈ Ceiling / Maximum ───────────────────────────────────────────────
// complex not accepted
prim_def("Z←⌈B", ¯3 ¯100 (0 1 1 0 0) 3 RE, , , "(⍴Z)≡⍴B")
prim_def("Z←A⌈B", ¯3 ¯100 (0 1 1 0 0) 3 RE, ~B, , "(⍴Z)≡⍴B")

// ── ⌊ Floor / Minimum ─────────────────────────────────────────────────
prim_def("Z←⌊B", ¯3 ¯100 (0 1 1 0 0) 3 RE, , , "(⍴Z)≡⍴B")
prim_def("Z←A⌊B", ¯3 ¯100 (0 1 1 0 0) 3 RE, ~B, , "(⍴Z)≡⍴B")

// ── | Magnitude / Residue ─────────────────────────────────────────────
// monadic accepts complex; dyadic A|B requires real
prim_def("Z←|B", ¯3 ¯100 (0 1 1 1 0) 3 RE, , , "(⍴Z)≡⍴B")
prim_def("Z←A|B", ¯3 ¯100 (0 1 1 0 0) 3 RE, ~B, , "(⍴Z)≡⍴B")

// ── * Exponential / Power ─────────────────────────────────────────────
prim_def("Z←*B", ¯3 ¯100 (0 1 1 1 0) 3 RE, , , "(⍴Z)≡⍴B")
prim_def("Z←A*B", ¯3 ¯100 (0 1 1 1 0) 3 RE, ~B, , "(⍴Z)≡⍴B")

// ── ⍟ Natural Log / Logarithm ─────────────────────────────────────────
prim_def("Z←⍟B", ¯3 ¯100 (0 1 1 1 0) 3 RE, , , "(⍴Z)≡⍴B")
prim_def("Z←A⍟B", ¯3 ¯100 (0 1 1 1 0) 3 RE, ~B, , "(⍴Z)≡⍴B")

// ── ! Factorial / Binomial ────────────────────────────────────────────
// integer only; factorial of large ints overflows intentionally
prim_def("Z←!B", ¯3 ¯100 (0 1 0 0 0) 0 RE, , , "(⍴Z)≡⍴B")
prim_def("Z←A!B", ¯3 ¯100 (0 1 0 0 0) 0 RE, ~B, , "(⍴Z)≡⍴B")

// ── ○ Pi-Times / Circular Functions ───────────────────────────────────
prim_def("Z←○B", ¯3 ¯100 (0 1 1 1 0) 3 RE, , , "(⍴Z)≡⍴B")
prim_def("Z←A○B", ¯3 ¯100 (0 1 1 1 0) 3 RE, 0 (0 1 0 0 0) 0 RE, , "(⍴Z)≡⍴B")

// ── < Less Than ───────────────────────────────────────────────────────
// no complex (ordering undefined there)
prim_def("Z←A<B", ¯3 ¯100 (0 1 1 0 0) 3 RE, ~B, , "(⍴Z)≡⍴B")

// ── ≤ Less or Equal ───────────────────────────────────────────────────
prim_def("Z←A≤B", ¯3 ¯100 (0 1 1 0 0) 3 RE, ~B, , "(⍴Z)≡⍴B")

// ── = Equal ───────────────────────────────────────────────────────────
// accepts any simple type; depth=0 to keep both A and B comparable
prim_def("Z←A=B", ¯3 ¯100 (1 1 1 1 0) 0 RE, ~B, , "(⍴Z)≡⍴B")

// ── ≥ Greater or Equal ────────────────────────────────────────────────
prim_def("Z←A≥B", ¯3 ¯100 (0 1 1 0 0) 3 RE, ~B, , "(⍴Z)≡⍴B")

// ── > Greater Than ────────────────────────────────────────────────────
prim_def("Z←A>B", ¯3 ¯100 (0 1 1 0 0) 3 RE, ~B, , "(⍴Z)≡⍴B")

// ── ≠ Not Equal ───────────────────────────────────────────────────────
prim_def("Z←A≠B", ¯3 ¯100 (1 1 1 1 0) 0 RE, ~B, , "(⍴Z)≡⍴B")

// ── ~ Logical Not / Without ───────────────────────────────────────────
// ~B: B must be Boolean (0/1); tc applies 2∣ after generating
prim_def("Z←~B", ¯3 ¯100 (0 1 0 0 0) 0 RE, , , "(⍴Z)≡⍴B")
// A~B (Without): A and B simple, any type
prim_def("Z←A~B", ¯3 ¯100 (1 1 1 1 0) 0 RE, ¯1 ¯100 (1 1 1 1 0) 0 RE, , "(⍴⍴Z)≡,1")

// ── ∧ And ─────────────────────────────────────────────────────────────
// Boolean (0/1); tc applies 2∣ after generating
prim_def("Z←A∧B", ¯3 ¯100 (0 1 0 0 0) 0 RE, ~B, , "(⍴Z)≡⍴B")

// ── ∨ Or ──────────────────────────────────────────────────────────────
prim_def("Z←A∨B", ¯3 ¯100 (0 1 0 0 0) 0 RE, ~B, , "(⍴Z)≡⍴B")

// ── ⍲ Nand ────────────────────────────────────────────────────────────
prim_def("Z←A⍲B", ¯3 ¯100 (0 1 0 0 0) 0 RE, ~B, , "(⍴Z)≡⍴B")

// ── ⍱ Nor ─────────────────────────────────────────────────────────────
prim_def("Z←A⍱B", ¯3 ¯100 (0 1 0 0 0) 0 RE, ~B, , "(⍴Z)≡⍴B")

// ── ? Roll / Deal ─────────────────────────────────────────────────────
// ?B: B positive integer, any rank; tc takes |B to ensure ≥ 0
prim_def("Z←?B", ¯3 ¯100 (0 1 0 0 0) 0 RE, , , "(⍴Z)≡⍴B")
// A?B: A and B must be scalars (A ≤ B); fixed rank 0
prim_def("Z←A?B", 0 (0 1 0 0 0) 0 RE, 0 (0 1 0 0 0) 0 RE, , "((⍴Z)≡,A)∧(⍴⍴Z)≡,1")

// ── ⍴ Shape / Reshape ─────────────────────────────────────────────────
// monadic: any argument including nested
prim_def("Z←⍴B", ¯3 ¯100 (1 1 1 1 1) 3 RE, , , "((⍴Z)≡⍴⍴B)∧(⍴⍴Z)≡,1")
// dyadic A⍴B: B is the data source; any type/shape
prim_def("Z←A⍴B", ¯3 ¯100 (1 1 1 1 1) 3 RE, 1 ¯8 (0 1 0 0 0) 0 RE, , "((⍴Z)≡,A)∧(⍴⍴Z)≡⍴,A")

// ── , Ravel / Catenate ────────────────────────────────────────────────
prim_def("Z←,B", ¯3 ¯100 (1 1 1 1 1) 3 RE, , , "((⍴Z)≡,×/⍴B)∧(⍴⍴Z)≡,1")
prim_def("Z←A,B", ¯3 ¯100 (1 1 1 1 1) 3 RE, ¯3 ¯100 (1 1 1 1 1) 3 RE, , "(⍴⍴Z)≡,⌈/(⍴⍴A),(⍴⍴B),1")
// monadic ,[X]B with integer X is the identity (only ,[X.5]B, the
// laminate case below, actually changes anything); X_stim is integer
// only here, so Z must equal B exactly, for every valid X
prim_def("Z←,[X]B", (0 3 2 1) ¯100 (1 1 1 1 1) 3 RE, , 0 (0 1 0 0 0) 0 RE, "Z≡B")
prim_def("Z←A,[X]B", (0 3 2 1) ¯100 (1 1 1 1 1) 3 RE, ¯3 ¯100 (1 1 1 1 1) 3 RE, 0 (0 1 0 0 0) 0 RE, "((⍴⍴Z)≡(⍴⍴A)⌈⍴⍴B)∧(⍴Z)[X]≡(⍴A)[X]+(⍴B)[X]")
// Laminate: A and B same rank; K is fractional axis
prim_def("Z←A,[X.5]B", (0 3 2 1) ¯100 (1 1 1 1 0) 0 RE, (0 3 2 1) ¯100 (1 1 1 1 0) 0 RE, 0 (0 0 1 0 0) 0 RE, "(⍴⍴Z)≡1+(⍴⍴A)⌈⍴⍴B")

// ── ⍪ Table / Catenate First ──────────────────────────────────────────
prim_def("Z←⍪B", ¯3 ¯100 (1 1 1 1 1) 3 RE, , , "(⍴⍴Z)≡,2⌈⍴⍴B")
prim_def("Z←A⍪B", (0 3 2 1) ¯100 (1 1 1 1 1) 3 RE, (0 3 2 1) ¯100 (1 1 1 1 1) 3 RE, , "(⍴⍴Z)≡(⍴⍴A)⌈⍴⍴B")

// ── ⌽ Reverse / Rotate ────────────────────────────────────────────────
prim_def("Z←⌽B", (0 3 2 1) ¯100 (1 1 1 1 1) 3 RE, , , "((⍴Z)≡⍴B)∧(⍴⍴Z)≡⍴⍴B")
prim_def("Z←A⌽B", (0 3 2 1) ¯100 (1 1 1 1 1) 3 RE, ¯2 ¯10 (0 1 0 0 0) 0 RE, , "((⍴Z)≡⍴B)∧(⍴⍴Z)≡⍴⍴B")
// verified via: transpose axis X to the last position (forward perm =
// grade-up of "other axes in order, then X"; the un-transposed "other
// axes in order, then X" itself is the inverse perm to transpose back),
// reverse/rotate along that now-last axis with plain ⌽/A⌽, transpose
// back — this reduces the axis-X case to the well-known no-axis case
prim_def("Z←⌽[X]B", (0 3 2 1) ¯100 (1 1 1 1 1) 3 RE, , 0 (0 1 0 0 0) 0 RE, "Z≡(((⍳⍴⍴B)~X),X)⍉⌽(⍋((⍳⍴⍴B)~X),X)⍉B")
prim_def("Z←A⌽[X]B", (0 3 2 1) ¯100 (1 1 1 1 1) 3 RE, ¯1 ¯100 (0 1 0 0 0) 0 RE, 0 (0 1 0 0 0) 0 RE, "Z≡(((⍳⍴⍴B)~X),X)⍉A⌽(⍋((⍳⍴⍴B)~X),X)⍉B")

// ── ⊖ Reverse First / Rotate First ───────────────────────────────────
prim_def("Z←⊖B", (0 3 2 1) ¯100 (1 1 1 1 1) 3 RE, , , "((⍴Z)≡⍴B)∧(⍴⍴Z)≡⍴⍴B")
prim_def("Z←A⊖B", (0 3 2 1) ¯100 (1 1 1 1 1) 3 RE, ¯2 ¯10 (0 1 0 0 0) 0 RE, , "((⍴Z)≡⍴B)∧(⍴⍴Z)≡⍴⍴B")

// ── ⍉ Transpose ───────────────────────────────────────────────────────
// requires rank ≥ 1 for monadic; rank distribution skips scalars
prim_def("Z←⍉B", (0 3 2 1) ¯100 (1 1 1 1 1) 3 RE, , , "((⍴Z)≡⌽⍴B)∧(⍴⍴Z)≡⍴⍴B")
prim_def("Z←A⍉B", (0 3 2 1) ¯100 (1 1 1 1 1) 3 RE, 1 ¯8 (0 1 0 0 0) 0 RE, , "(⍴⍴Z)≡⍴⍴B")

// ── ↑ Mix / Take ──────────────────────────────────────────────────────
// monadic ↑B: benefits from nested input (Mix operation)
prim_def("Z←↑B", ¯3 ¯100 (1 1 1 1 1) 3 RE, , , "(⍴⍴Z)≥⍴⍴B")
// dyadic A↑B: B is the array to take from; any type/shape
prim_def("Z←A↑B", ¯3 ¯100 (1 1 1 1 1) 3 RE, 1 ¯8 (0 1 0 0 0) 0 RE, , "((⍴Z)≡|,A)∧(⍴⍴Z)≡⍴,A")
// verified: transpose axis X to last (same forward/inverse perm pair as
// ⌽[X]B above), take A along that now-last axis via a vector left arg
// that leaves every other (transposed) axis at its current full size
// (no padding/truncation there), transpose back
prim_def("Z←A↑[X]B", (0 3 2 1) ¯100 (1 1 1 1 1) 3 RE, 0 (0 1 0 0 0) 0 RE, ¯1 ¯3 (0 1 0 0 0) 0 RE, "Z≡(((⍳⍴⍴B)~X),X)⍉((¯1↓⍴(⍋((⍳⍴⍴B)~X),X)⍉B),A)↑(⍋((⍳⍴⍴B)~X),X)⍉B")

// ── ↓ Split / Drop ────────────────────────────────────────────────────
// monadic ↓B: rank ≥ 1 (Split); B any nonscalar
prim_def("Z←↓B", (0 3 2 1) ¯100 (1 1 1 1 1) 3 RE, , , "((⍴Z)≡1↑⍴B)∧(⍴⍴Z)≡,1")
prim_def("Z←A↓B", ¯3 ¯100 (1 1 1 1 1) 3 RE, 1 ¯8 (0 1 0 0 0) 0 RE, , "((⍴Z)≡0⌈(⍴B)-|A)∧(⍴⍴Z)≡(⍴,A)⌈⍴⍴B")
// same transpose trick as A↑[X]B above, but drop (0 = drop nothing) on
// every other (transposed) axis instead of take-full
prim_def("Z←A↓[X]B", (0 3 2 1) ¯100 (1 1 1 1 1) 3 RE, 0 (0 1 0 0 0) 0 RE, ¯1 ¯3 (0 1 0 0 0) 0 RE, "Z≡(((⍳⍴⍴B)~X),X)⍉((0×¯1↓⍴(⍋((⍳⍴⍴B)~X),X)⍉B),A)↓(⍋((⍳⍴⍴B)~X),X)⍉B")

// ── ⍳ Interval Index / Index Of ──────────────────────────────────────
// monadic ⍳B: B integer (scalar or vector); tc takes |B to ensure ≥ 0
prim_def("Z←⍳B", ¯1 1 (0 1 0 0 0) 0 RE, , , "((⍴Z)≡,B)∧(⍴⍴Z)≡,1")
// dyadic A⍳B: A simple array; B same type as A
prim_def("Z←A⍳B", ¯3 ¯100 (1 1 1 1 0) 0 RE, 1 ¯100 (1 1 1 1 0) 0 RE, , "((⍴Z)≡⍴B)∧(⍴⍴Z)≡⍴⍴B")

// ── ∊ Enlist / Member ─────────────────────────────────────────────────
// monadic ∊B: any (especially useful nested); result always simple vector
prim_def("Z←∊B", ¯3 ¯100 (1 1 1 1 1) 3 RE, , , "(⍴⍴Z)≡,1")
// dyadic A∊B: both simple; membership test
prim_def("Z←A∊B", ¯3 ¯100 (1 1 1 1 0) 0 RE, ¯3 ¯100 (1 1 1 1 0) 0 RE, , "((⍴Z)≡⍴A)∧(⍴⍴Z)≡⍴⍴A")

// ── ⍷ Find ────────────────────────────────────────────────────────────
// A⍷B: both same type, simple; B is the searched array
prim_def("Z←A⍷B", (0 3 2 1) ¯100 (1 1 1 1 0) 0 RE, (0 3 2 1) ¯10 (1 1 1 1 0) 0 RE, , "((⍴Z)≡⍴B)∧(⍴⍴Z)≡⍴⍴B")

// ── ⊂ Enclose / Partitioned Enclose ──────────────────────────────────
prim_def("Z←⊂B", ¯3 ¯100 (1 1 1 1 1) 3 RE, , , "((⍴Z)≡⍳0)∧(⍴⍴Z)≡,0")
// dyadic A⊂B (APL2 Partitioned Enclose): A is Boolean/integer vector, B simple nonscalar
prim_def("Z←A⊂B", (0 3 2 1) ¯100 (1 1 1 1 0) 0 RE, 1 ¯100 (0 1 0 0 0) 0 RE, , "(⍴⍴Z)≡⍴⍴B")
prim_def("Z←⊂[X]B", (0 3 2 1) ¯100 (1 1 1 1 0) 0 RE, , ¯1 ¯3 (0 1 0 0 0) 0 RE, "(⍴⍴Z)≡,(⍴⍴B)-⍴,X")
// A⊂B (no axis) partitions along the LAST axis and, unlike ⊂[X] alone,
// preserves rank (the partitioned axis's length becomes the group
// count); same transpose trick as above, no rank adjustment needed
prim_def("Z←A⊂[X]B", (0 3 2 1) ¯100 (1 1 1 1 0) 0 RE, 1 ¯100 (0 1 0 0 0) 0 RE, 0 (0 1 0 0 0) 0 RE, "Z≡(((⍳⍴⍴B)~X),X)⍉A⊂(⍋((⍳⍴⍴B)~X),X)⍉B")

// ── ⊃ First / Disclose / Pick ─────────────────────────────────────────
// monadic ⊃B: benefits from nested input
prim_def("Z←⊃B", ¯3 ¯100 (1 1 1 1 1) 3 RE, , , "1")
// dyadic A⊃B (Pick): B is a nested array
prim_def("Z←A⊃B", ¯3 ¯100 (1 1 1 1 1) 3 RE, 0 (0 1 0 0 0) 0 RE, , "1")
// per Bif_F12_PARTITION_PICK.cc's disclose_with_axis(): Z←⊃[X]B is
// defined as cB←⊃B (plain disclose, no axis) then cB transposed by the
// permutation "cB's axes not in X, in order, followed by X" — verified
// against that source both algebraically and empirically (all 3 axis
// positions on a rank1-of-rank2 nested B)
prim_def("Z←⊃[X]B", (0 3 2 1) ¯100 (1 1 1 1 1) 3 RE, , ¯1 ¯3 (0 1 0 0 0) 0 RE, "Z≡(((⍳⍴⍴⊃B)~X),X)⍉⊃B")

// ── ≡ Depth / Match ───────────────────────────────────────────────────
prim_def("Z←≡B", ¯3 ¯100 (1 1 1 1 1) 3 RE, , , "((⍴Z)≡⍳0)∧(⍴⍴Z)≡,0")
prim_def("Z←A≡B", ¯3 ¯100 (1 1 1 1 1) 3 RE, ¯3 ¯100 (1 1 1 1 1) 3 RE, , "((⍴Z)≡⍳0)∧(⍴⍴Z)≡,0")

// ── ≢ Tally / Mismatch ────────────────────────────────────────────────
prim_def("Z←≢B", ¯3 ¯100 (1 1 1 1 1) 3 RE, , , "((⍴Z)≡⍳0)∧(⍴⍴Z)≡,0")
prim_def("Z←A≢B", ¯3 ¯100 (1 1 1 1 1) 3 RE, ¯3 ¯100 (1 1 1 1 1) 3 RE, , "((⍴Z)≡⍳0)∧(⍴⍴Z)≡,0")

// ── ⍋ Grade Up ────────────────────────────────────────────────────────
// simple only (no complex, no nested); rank ≥ 1; char or real
prim_def("Z←⍋B", (0 3 2 1) ¯100 (10 70 15 0 0) 0 RE, , , "((⍴Z)≡1↑⍴B)∧(⍴⍴Z)≡,1")
// dyadic A⍋B (collating grade): B must be char
prim_def("Z←A⍋B", (0 3 2 1) ¯100 (1 0 0 0 0) 0 RE, (0 3 2 1) ¯100 (1 0 0 0 0) 0 RE, , "((⍴Z)≡1↑⍴B)∧(⍴⍴Z)≡,1")

// ── ⍒ Grade Down ──────────────────────────────────────────────────────
prim_def("Z←⍒B", (0 3 2 1) ¯100 (10 70 15 0 0) 0 RE, , , "((⍴Z)≡1↑⍴B)∧(⍴⍴Z)≡,1")
prim_def("Z←A⍒B", (0 3 2 1) ¯100 (1 0 0 0 0) 0 RE, (0 3 2 1) ¯100 (1 0 0 0 0) 0 RE, , "((⍴Z)≡1↑⍴B)∧(⍴⍴Z)≡,1")

// ── ⊥ Decode ──────────────────────────────────────────────────────────
// A⊥B: both numeric, no complex
prim_def("Z←A⊥B", (0 3 2 1) ¯100 (0 1 1 0 0) 0 RE, (0 1 1 1) ¯16 (0 1 0 0 0) 0 RE, , "((⍴Z)≡(¯1↓⍴A),1↓⍴B)∧(⍴⍴Z)≡,(0⌈¯1+⍴⍴A)+(0⌈¯1+⍴⍴B")

// ── ⊤ Encode ──────────────────────────────────────────────────────────
prim_def("Z←A⊤B", (0 3 2 1) ¯100 (0 1 1 0 0) 0 RE, (0 1 1 1) ¯16 (0 1 1 0 0) 0 RE, , "((⍴Z)≡(⍴A),⍴B)∧(⍴⍴Z)≡,(⍴⍴A)+⍴⍴B")

// ── ⌹ Matrix Inverse / Divide ─────────────────────────────────────────
// requires matrix (rank 2); real numeric only
prim_def("Z←⌹B", ¯2 ¯100 (0 1 1 0 0) 0 RE, , , "((⍴Z)≡⌽⍴B)∧(⍴⍴Z)≡⍴⍴B")
prim_def("Z←A⌹B", 2 ¯100 (0 1 1 0 0) 0 RE, ¯2 ¯100 (0 1 1 0 0) 0 RE, , "((⍴Z)≡(1↓⍴B),1↓⍴A)∧(⍴⍴Z)≡,1⌈¯2+(⍴⍴A)+⍴⍴B")

// ── ⍕ Format ──────────────────────────────────────────────────────────
// monadic: any simple type
prim_def("Z←⍕B", ¯3 ¯100 (1 1 1 1 0) 0 RE, , , "(⍴⍴Z)≡,1⌈⍴⍴B")
// dyadic A⍕B: A is format spec (integer), B is numeric
prim_def("Z←A⍕B", ¯3 ¯100 (0 1 1 0 0) 0 RE, 1 ¯10 (0 1 0 0 0) 0 RE, , "(⍴⍴Z)≡,1⌈⍴⍴B")

// ── ⍎ Execute ─────────────────────────────────────────────────────────
// B must be character; note: random chars rarely make valid APL
prim_def("Z←⍎B", ¯3 ¯100 (1 0 0 0 0) 0 RE, , , "1")

// ── ∪ Unique / Union ──────────────────────────────────────────────────
// simple arrays only
prim_def("Z←∪B", (0 3 2 1) ¯100 (1 1 1 1 0) 0 RE, , , "(⍴⍴Z)≡⍴⍴B")
prim_def("Z←A∪B", (0 3 2 1) ¯100 (1 1 1 1 0) 0 RE, ¯3 ¯100 (1 1 1 1 0) 0 RE, , "(⍴⍴Z)≡⍴⍴A")

// ── ∩ Intersection ────────────────────────────────────────────────────
prim_def("Z←A∩B", (0 3 2 1) ¯100 (1 1 1 1 0) 0 RE, ¯3 ¯100 (1 1 1 1 0) 0 RE, , "(⍴⍴Z)≡⍴⍴A")

// ── ⌷ Index (Squad) ───────────────────────────────────────────────────
// B is the array being indexed; any type including nested
prim_def("Z←A⌷B", ¯3 ¯100 (1 1 1 1 1) 3 RE, ¯1 ¯10 (0 1 0 0 0) 0 RE, , "1")

// ── A[I] Bracket Indexing ─────────────────────────────────────────────
// A is the array; indices are integer; only rank matters here
prim_def("Z←A[B]",   ¯3 ¯100 (1 1 1 1 1) 3 RE, ¯3 ¯100 (0 1 0 0 0) 0 RE, , "(⍴Z)≡⍴B")
prim_def("Z←A[I]",   ¯3 ¯100 (1 1 1 1 1) 3 RE, ¯1 ¯100 (0 1 0 0 0) 0 RE, , "(⍴Z)≡⍴I")
prim_def("Z←A[I;J]", 2 ¯100 (1 1 1 1 1) 3 RE, ¯1 ¯100 (0 1 0 0 0) 0 RE, , "(⍴Z)≡(⍴I),⍴J")
prim_def("Z←A[I;J;K]", 3 ¯100 (1 1 1 1 1) 3 RE, ¯1 ¯100 (0 1 0 0 0) 0 RE, , "(⍴Z)≡(⍴I),(⍴J),⍴K")

// ── / Compress / Replicate (used as function) ─────────────────────────
// B nonscalar; A Boolean for Compress, integer for Replicate
prim_def("Z←A/B", (0 3 2 1) ¯100 (1 1 1 1 0) 0 RE, 1 ¯100 (0 1 0 0 0) 0 RE, , "((¯1↓⍴Z)≡¯1↓⍴B)∧(⍴⍴Z)≡⍴⍴B")
// same transpose trick as ⌽[X]B above: A/B (no axis) already operates
// along the last axis, so move axis X there, apply plain /, move back
prim_def("Z←A/[X]B", (0 3 2 1) ¯100 (1 1 1 1 0) 0 RE, 1 ¯100 (0 1 0 0 0) 0 RE, 0 (0 1 0 0 0) 0 RE, "Z≡(((⍳⍴⍴B)~X),X)⍉A/(⍋((⍳⍴⍴B)~X),X)⍉B")
prim_def("Z←A⌿B", (0 3 2 1) ¯100 (1 1 1 1 0) 0 RE, 1 ¯100 (0 1 0 0 0) 0 RE, , "((1↓⍴Z)≡1↓⍴B)∧(⍴⍴Z)≡⍴⍴B")

// ── \ Expand (used as function) ───────────────────────────────────────
prim_def("Z←A\\B", (0 3 2 1) ¯100 (1 1 1 1 0) 0 RE, 1 ¯100 (0 1 0 0 0) 0 RE, , "((¯1↓⍴Z)≡¯1↓⍴B)∧(⍴⍴Z)≡⍴⍴B")
// same transpose trick as A/[X]B above
prim_def("Z←A\\[X]B", (0 3 2 1) ¯100 (1 1 1 1 0) 0 RE, 1 ¯100 (0 1 0 0 0) 0 RE, 0 (0 1 0 0 0) 0 RE, "Z≡(((⍳⍴⍴B)~X),X)⍉A\\(⍋((⍳⍴⍴B)~X),X)⍉B")
prim_def("Z←A⍀B", (0 3 2 1) ¯100 (1 1 1 1 0) 0 RE, 1 ¯100 (0 1 0 0 0) 0 RE, , "((1↓⍴Z)≡1↓⍴B)∧(⍴⍴Z)≡⍴⍴B")

// ── f/ Reduce ─────────────────────────────────────────────────────────
// B nonscalar; f is an arbitrary scalar function
prim_def("Z←f/B", (0 3 2 1) ¯100 (1 1 1 1 0) 0 RE, , , "((⍴Z)≡¯1↓⍴B)∧(⍴⍴Z)≡,0⌈¯1+⍴⍴B")
// NOTE: 'f' is substituted (to a concrete function from CONTEXT.FPOOL)
// only in OPER, never in this constraint (ONE_PRIMITIVE in
// AllPrimitives.tc), so the constraint cannot invoke f itself and the
// full value-checking transpose trick used for e.g. ⌽[X]B/A/[X]B above
// does not apply here. This is the strongest f-independent check
// possible: unlike the old rank-only check, it confirms axis X
// specifically (not just some axis) was the one removed, with every
// other axis's length preserved in its original relative order
prim_def("Z←f/[X]B", (0 3 2 1) ¯100 (1 1 1 1 0) 0 RE, , 0 (0 1 0 0 0) 0 RE, "(⍴Z)≡(⍴B)[(⍳⍴⍴B)~X]")
prim_def("Z←f⌿B", (0 3 2 1) ¯100 (1 1 1 1 0) 0 RE, , , "((⍴Z)≡1↓⍴B)∧(⍴⍴Z)≡,0⌈¯1+⍴⍴B")
// N-Wise Reduce: A is window size (scalar integer), B is the array
prim_def("Z←Af/B", (0 3 2 1) ¯100 (0 1 1 1 0) 0 RE, 0 (0 1 0 0 0) 0 RE, , "((⍴Z)≡(¯1↓⍴B),(1+(¯1↑⍴B)-|A))∧(⍴⍴Z)≡⍴⍴B")

// ── f\ Scan ───────────────────────────────────────────────────────────
prim_def("Z←f\\B", (0 3 2 1) ¯100 (1 1 1 1 0) 0 RE, , , "((⍴Z)≡⍴B)∧(⍴⍴Z)≡⍴⍴B")
// NOTE: same f-not-available-in-constraints limitation as f/[X]B above.
// Unlike reduce, scan never changes any axis's length (only values), so
// there is no axis-specific shape fact left to add here beyond full
// shape equality — already the strongest check possible without f.
prim_def("Z←f\\[X]B", (0 3 2 1) ¯100 (1 1 1 1 0) 0 RE, , 0 (0 1 0 0 0) 0 RE, "(⍴Z)≡⍴B")
prim_def("Z←f⍀B", (0 3 2 1) ¯100 (1 1 1 1 0) 0 RE, , , "((⍴Z)≡⍴B)∧(⍴⍴Z)≡⍴⍴B")

// ── f¨ Each ───────────────────────────────────────────────────────────
prim_def("Z←f¨B", ¯3 ¯100 (1 1 1 1 1) 3 RE, , , "((⍴Z)≡⍴B)∧(⍴⍴Z)≡⍴⍴B")
prim_def("Z←Af¨B", ¯3 ¯100 (1 1 1 1 1) 3 RE, ~B, , "((⍴Z)≡⍴B)∧(⍴⍴Z)≡(⍴⍴A)⌈⍴⍴B")

// ── Af.gB Inner Product ───────────────────────────────────────────────
// A and B must be conformable; numeric only for typical f.g
prim_def("Z←Af.gB", 2 ¯100 (0 1 1 1 0) 0 RE, 2 ¯100 (0 1 1 1 0) 0 RE, , "((⍴Z)≡(¯1↓⍴A),1↓⍴B)∧(⍴⍴Z)≡,0⌈¯2+(⍴⍴A)+⍴⍴B")

// ── A∘.fB Outer Product ───────────────────────────────────────────────
// A and B can be any shape/type; result is rank(A)+rank(B)
prim_def("Z←A∘.fB", ¯3 ¯100 (1 1 1 1 0) 0 RE, ¯3 ¯100 (1 1 1 1 0) 0 RE, , "((⍴Z)≡(⍴A),⍴B)∧(⍴⍴Z)≡,(⍴⍴A)+⍴⍴B")

// ── f⍣N Power Operator ────────────────────────────────────────────────
// B is the starting value; N is the iteration count (non-negative integer)
prim_def("Z←Bf⍣NB", ¯3 ¯100 (0 1 1 1 0) 0 RE, 0 (0 1 0 0 0) 0 RE, , "(⍴Z)≡⍴B")

// ── f⍤[K] Rank Operator ───────────────────────────────────────────────
// FIX: the rank operator ⍤ takes its rank as a plain value right
// operand (f⍤K, per apl.texi's own documented examples, e.g.
// "0 1 2(⌽⍤0 1) 'ABC'") -- NOT bracket-axis notation f⍤[K]. The old
// arity strings ("Bf⍤[X]B" / "Af⍤[X]B") used bracket-axis syntax, which
// is invalid for ⍤ and always raised RANK ERROR on every attempt, so
// this row could never previously execute far enough to reach its
// constraint at all (⎕EC OPER always failed, going straight to
// ONE_PRIMITIVE's FAIL path). Also dropped a spurious leading "B" from
// the monadic row's arity, which combined with the caller having no
// left argument would itself have been wrong.
//
// Constraints: f is always one of CONTEXT.FPOOL's scalar functions
// (+-×⌈⌊), and scalar functions distribute over any rank/cell
// decomposition -- i.e. f⍤K B ≡ f B and A f⍤K B ≡ A f B for EVERY valid
// K (verified empirically for several K per rank, including K=0). So
// the rank actually chosen for X does not change the result at all;
// the strongest fact checkable without invoking f (not available in
// this constraint - see the f/[X]B note above) is the shape a plain
// (unranked) scalar function call would have: unchanged shape for the
// monadic case, and normal scalar-extension shape for the dyadic case
prim_def("Z←f⍤X B", ¯3 ¯100 (1 1 1 1 0) 0 RE, , 0 (0 1 0 0 0) 0 RE, "(⍴Z)≡⍴B")
prim_def("Z←A f⍤X B", ¯3 ¯100 (1 1 1 1 0) 0 RE, ¯3 ¯100 (1 1 1 1 0) 0 RE, 0 (0 1 0 0 0) 0 RE, "((⍴Z)≡⍴A)∨(⍴Z)≡⍴B")

//undef prim_def

