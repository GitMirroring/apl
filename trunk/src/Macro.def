/// \cond NOPE

/// monadic EACH without result
//
mac_def(LO_EACH_B,
 "(μ4 μ¯1) μ1;μ6;μ7\n"
 "⍝ called as Bif_OPER1_EACH::eval_LB(_LO, B)\n"
 "⍝\n"
 "⍝ μ1 = B  (C++ B),  ravelled in place\n"
 "⍝ μ4 = LO (C++ _LO), the operand function applied to each element of B\n"
 "⍝ μ6 = N,     loop index (⎕IO-based), local to the macro\n"
 "⍝ μ7 = N_max, loop limit,             local to the macro\n"
 "⍝\n"
 "μ6←⎕IO ◊ μ7←μ6+⍴μ1←,μ1\n"
 "μ4 μ6⊃μ1 ◊ 0 → μ7>μ6←μ6+1\n")

/// dyadic EACH without result, scalar A, scalar B
//
mac_def(sA_LO_EACH_sB,
 "μ2 (μ4 μ¯2) μ1\n"
 "⍝ called as Bif_OPER1_EACH::eval_ALB(A, _LO, B)\n"
 "⍝\n"
 "⍝ μ1 = B  (C++ B)\n"
 "⍝ μ2 = A  (C++ A)\n"
 "⍝ μ4 = LO (C++ _LO)\n"
 "⍝\n"
 "μ2 μ4 μ1\n")

/// dyadic EACH without result, scalar A, vector B
//
mac_def(sA_LO_EACH_vB,
 "μ2 (μ4 μ¯3) μ1;μ6;μ7\n"
 "⍝ called as Bif_OPER1_EACH::eval_ALB(A, _LO, B)\n"
 "⍝\n"
 "⍝ μ1 = B  (C++ B, vector), ravelled in place\n"
 "⍝ μ2 = A  (C++ A, scalar), disclosed each iteration\n"
 "⍝ μ4 = LO (C++ _LO)\n"
 "⍝ μ6 = N,     loop index (over B), local to the macro\n"
 "⍝ μ7 = N_max, loop limit,          local to the macro\n"
 "⍝\n"
 "μ6←⎕IO ◊ μ7←μ6+⍴μ1←,μ1\n"
 "(⊃μ2) μ4 μ6⊃μ1 ◊ 0 → μ7>μ6←μ6+1\n")

/// dyadic EACH without result, vector A, scalar B
//
mac_def(vA_LO_EACH_sB,
 "μ2 (μ4 μ¯4) μ1;μ6;μ7\n"
 "⍝ called as Bif_OPER1_EACH::eval_ALB(A, _LO, B)\n"
 "⍝\n"
 "⍝ μ1 = B  (C++ B, scalar), disclosed each iteration\n"
 "⍝ μ2 = A  (C++ A, vector), ravelled in place\n"
 "⍝ μ4 = LO (C++ _LO)\n"
 "⍝ μ6 = N,     loop index (over A), local to the macro\n"
 "⍝ μ7 = N_max, loop limit,          local to the macro\n"
 "⍝\n"
 "μ6←⎕IO ◊ μ7←μ6+⍴μ2←,μ2\n"
 "(μ6⊃μ2) μ4 ⊃μ1 ◊ 0 → μ7>μ6←μ6+1\n")

/// dyadic EACH without result, vector A, vector B
//
mac_def(vA_LO_EACH_vB,
 "μ2 (μ4 μ¯5) μ1;μ6;μ7\n"
 "⍝ called as Bif_OPER1_EACH::eval_ALB(A, _LO, B)\n"
 "⍝\n"
 "⍝ μ1 = B  (C++ B, vector), ravelled in place\n"
 "⍝ μ2 = A  (C++ A, vector), ravelled in place\n"
 "⍝ μ4 = LO (C++ _LO)\n"
 "⍝ μ6 = N,     loop index (over A and B in parallel), local to the macro\n"
 "⍝ μ7 = N_max, loop limit,                             local to the macro\n"
 "⍝\n"
 "μ6←⎕IO ◊ μ2←,μ2 ◊ μ7←μ6+⍴μ1←,μ1\n"
 "(μ6⊃μ2) μ4 μ6⊃μ1 ◊ 0 → μ7>μ6←μ6+1\n")

/// monadic EACH with result
//
mac_def(Z__LO_EACH_B,
 "μ6←(μ4 μ¯6) μ1;μ7;μ8;μ9\n"
 "⍝ called as Bif_OPER1_EACH::eval_LB(_LO, B)\n"
 "⍝\n"
 "⍝ μ1 = B  (C++ B), ravelled in place\n"
 "⍝ μ4 = LO (C++ _LO)\n"
 "⍝ μ6 = Z, the result returned to the C++ caller\n"
 "⍝ μ7 = rho_Z, B's original shape (⍴B, saved before ravel), local to the macro\n"
 "⍝ μ8 = N,     loop index,                                  local to the macro\n"
 "⍝ μ9 = N_max, loop limit,                                  local to the macro\n"
 "⍝\n"
 "μ7←⍴μ1 ◊ μ8←⎕IO ◊ μ9←μ8+⍴μ1←,μ1 ◊ μ6←μ9⍴0\n"
 "(μ8⊃μ6)←μ4 μ8⊃μ1 ◊ 0 → μ9>μ8←μ8+1\n"
 "μ6←μ7⍴μ6\n")

/// dyadic EACH with result, scalar A, scalar B
//
mac_def(Z__sA_LO_EACH_sB,
 "μ6←μ2 (μ4 μ¯7) μ1\n"
 "⍝ called as Bif_OPER1_EACH::eval_ALB(A, _LO, B)\n"
 "⍝\n"
 "⍝ μ1 = B  (C++ B)\n"
 "⍝ μ2 = A  (C++ A)\n"
 "⍝ μ4 = LO (C++ _LO)\n"
 "⍝ μ6 = Z, the result returned to the C++ caller\n"
 "⍝\n"
 "μ6←⊂μ2 μ4 μ1\n")

/// dyadic EACH with result, scalar A, vector B
//
mac_def(  Z__sA_LO_EACH_vB,
 "μ6←μ2 (μ4 μ¯8) μ1;μ7;μ8;μ9\n"
 "⍝ called as Bif_OPER1_EACH::eval_ALB(A, _LO, B)\n"
 "⍝\n"
 "⍝ μ1 = B  (C++ B, vector), ravelled in place\n"
 "⍝ μ2 = A  (C++ A, scalar), disclosed each iteration\n"
 "⍝ μ4 = LO (C++ _LO)\n"
 "⍝ μ6 = Z, the result returned to the C++ caller\n"
 "⍝ μ7 = rho_Z, B's shape (⍴B), local to the macro\n"
 "⍝ μ8 = N,     loop index,     local to the macro\n"
 "⍝ μ9 = N_max, loop limit,     local to the macro\n"
 "⍝\n"
 "μ7←⍴μ1 ◊ μ8←⎕IO ◊ μ9←μ8+⍴μ1←,μ1 ◊ μ6←μ9⍴0\n"
 "(μ8⊃μ6)←⊂(⊃μ2) μ4 μ8⊃μ1 ◊ 0 → μ9>μ8←μ8+1\n"
 "μ6←μ7⍴μ6\n")

/// dyadic EACH with result, vector A, scalar B
//
mac_def(  Z__vA_LO_EACH_sB,
 "μ6←μ2 (μ4 μ¯9) μ1;μ7;μ8;μ9\n"
 "⍝ called as Bif_OPER1_EACH::eval_ALB(A, _LO, B)\n"
 "⍝\n"
 "⍝ μ1 = B  (C++ B, scalar), disclosed each iteration\n"
 "⍝ μ2 = A  (C++ A, vector), ravelled in place\n"
 "⍝ μ4 = LO (C++ _LO)\n"
 "⍝ μ6 = Z, the result returned to the C++ caller\n"
 "⍝ μ7 = rho_Z, A's shape (⍴A), local to the macro\n"
 "⍝ μ8 = N,     loop index,     local to the macro\n"
 "⍝ μ9 = N_max, loop limit,     local to the macro\n"
 "⍝\n"
 "μ7←⍴μ2 ◊ μ8←⎕IO ◊ μ9←μ8+⍴μ2←,μ2 ◊ μ6←μ9⍴0\n"
 "(μ8⊃μ6)←⊂(μ8⊃μ2) μ4 ⊃μ1 ◊ 0 → μ9>μ8←μ8+1\n"
 "μ6←μ7⍴μ6\n")

/// dyadic EACH with result, vector A, vector B
//
mac_def(  Z__vA_LO_EACH_vB,
 "μ6←μ2 (μ4 μ¯10) μ1;μ7;μ8;μ9\n"
 "⍝ called as Bif_OPER1_EACH::eval_ALB(A, _LO, B)\n"
 "⍝\n"
 "⍝ μ1 = B  (C++ B, vector), ravelled in place\n"
 "⍝ μ2 = A  (C++ A, vector); shapes of A and B are checked to match first\n"
 "⍝ μ4 = LO (C++ _LO)\n"
 "⍝ μ6 = Z, the result returned to the C++ caller\n"
 "⍝ μ7 = rho_Z, B's shape (⍴B), local to the macro\n"
 "⍝ μ8 = N,     loop index,     local to the macro\n"
 "⍝ μ9 = N_max, loop limit,     local to the macro\n"
 "⍝\n"
 "1 → (⍴μ2)≡⍴μ1 ◊ ⎕ES 5,2+(⍴⍴μ2)=⍴⍴μ1\n"
 "μ7←⍴μ1 ◊ μ8←⎕IO ◊ μ2←,μ2 ◊ μ9←μ8+⍴μ1←,μ1 ◊ μ6←μ9⍴0\n"
 "(μ8⊃μ6)←(μ8⊃μ2) μ4 μ8⊃μ1 ◊ 0 → μ9>μ8←μ8+1\n"
 "μ6←μ7⍴μ6\n")

/// outer product
//
mac_def(  Z__A_LO_OUTER_B,
 "μ6←μ2 (μ4 μ¯11) μ1;μ7;μ8;μ9;μ10;μ11;μ12\n"
 "⍝ called as Bif_OPER2_OUTER::eval_ALB(A, _RO, B) -- note: for ∘.f,\n"
 "⍝ C++'s RO (f) fills this macro's LO slot (∘.f's own left operand ∘\n"
 "⍝ is fixed and never passed in)\n"
 "⍝\n"
 "⍝ μ1 = B  (C++ B), ravelled in place\n"
 "⍝ μ2 = A  (C++ A), ravelled in place\n"
 "⍝ μ4 = LO (C++ _RO, i.e. f in ∘.f)\n"
 "⍝ μ6 = Z, the result returned to the C++ caller\n"
 "⍝ μ7 = rho_Z, the result's shape ((⍴A),⍴B), local to the macro\n"
 "⍝ μ8 = N,     loop index,                   local to the macro\n"
 "⍝ μ9 = N_max, loop limit,                   local to the macro\n"
 "⍝ μ10 = I,  cartesian-product index list ,⍳(⍴A),⍴B, local to the macro\n"
 "⍝ μ11 = IA, current A-index (disclosed from I[N]),   local to the macro\n"
 "⍝ μ12 = IB, current B-index (disclosed from I[N]),   local to the macro\n"
 "⍝\n"
 "μ7←(⍴μ2),⍴μ1 ◊ μ8←⎕IO ◊ μ2←,μ2 ◊ μ1←,μ1 ◊ μ10←,⍳(⍴μ2),⍴μ1 ◊ μ9←μ8+⍴μ10 ◊ μ6←μ9⍴0\n"
 "(μ11 μ12)←⊃μ10[μ8] ◊ μ6[μ8]←⊂(⊃μ2[μ11]) μ4 ⊃μ1[μ12] ◊ 0 → μ9>μ8←μ8+1\n"
 "μ6←μ7⍴μ6\n")

/// inner product. caller has checked that the shapes of A and B fit
//
mac_def(  Z__A_LO_INNER_RO_B,
 "μ6←μ2 (μ4 μ¯12 μ5) μ1;⎕IO\n"
 "⍝ called as Bif_OPER2_INNER::eval_ALRB(A, _LO, _RO, B)\n"
 "⍝\n"
 "⍝ μ1 = B  (C++ B)\n"
 "⍝ μ2 = A  (C++ A)\n"
 "⍝ μ4 = LO (C++ _LO), the reduce function of A LO.RO B (the '+' in +.×)\n"
 "⍝ μ5 = RO (C++ _RO), the elementwise function (the '×' in +.×)\n"
 "⍝ μ6 = Z, the result returned to the C++ caller\n"
 "⍝ ⎕IO is localized to 1 here (harmless, purely to shorten the branch\n"
 "⍝ and index arithmetic below); the C++ caller has already checked\n"
 "⍝ that A's and B's shapes fit\n"
 "⍝\n"
 "    ⎕IO←1 ◊ 3 → (⍴⍴μ2)=0 ◊ 2 → (⍴⍴μ1)=0\n"
 " μ6←μ4/¨ (⊂[ρρμ2]μ2) ∘.μ5 ⊂[1]μ1 ◊ →0\n"
 " μ6←μ4/¨ (⊂[ρρμ2]μ2) ∘.μ5 ⊂μ1    ◊ →0\n"
 " 2 → (⍴⍴μ1)=0\n"
 " μ6←μ4/¨ (⊂μ2)      ∘.μ5 ⊂[1]μ1 ◊ →0\n"
 " μ6←μ4/¨ (⊂μ2)      ∘.μ5 ⊂μ1    ◊ →0\n")

/// monadic power with repeat count and no result
//
mac_def(  LO_POWER_N_B,
  " μ2 (μ4 μ¯13 μ3) μ1\n"
"⍝ called as Bif_OPER2_POWER::eval_LRB(_LO, N, B) -- LO⍣N B, no result\n"
"⍝\n"
"⍝ μ1 = B (C++ B; originally named Z in the source, fed through LO in\n"
"⍝ place); no separate result -- the macro has no Z←\n"
"⍝ μ2 = A, unused (only reached for the monadic LO⍣N B form)\n"
"⍝ μ3 = N  (C++ N, the repeat count), decremented once per iteration\n"
"⍝ μ4 = LO (C++ _LO), applied N times\n"
"⍝\n"
"μ4 μ1 ◊ 0 → 0<μ3←μ3-1\n")

/// dyadic power with repeat count and no result
//
mac_def(  A_LO_POWER_N_B,
  " μ2 (μ4 μ¯14 μ3) μ1\n"
"⍝ called as Bif_OPER2_POWER::eval_ALRB(A, _LO, N, B) -- A LO⍣N B, no result\n"
"⍝\n"
"⍝ μ1 = B (C++ B; originally named Z in the source, updated in place\n"
"⍝ each iteration); no separate result -- the macro has no Z←\n"
"⍝ μ2 = A  (C++ A), the fixed left argument of LO on every iteration\n"
"⍝ μ3 = N  (C++ N, the repeat count), decremented once per iteration\n"
"⍝ μ4 = LO (C++ _LO), applied N times\n"
"⍝\n"
"μ2 μ4 μ1 ◊ 0 → 0<μ3←μ3-1\n")

/// monadic power with repeat count and result
//
mac_def(  Z__LO_POWER_N_B,
" μ1←μ2 (μ4 μ¯15 μ3) μ1\n"
"⍝ called as Bif_OPER2_POWER::eval_LRB(_LO, N, B) -- Z←LO⍣N B\n"
"⍝\n"
"⍝ μ1 = B (C++ B; originally named Z on both sides of the header, so\n"
"⍝ input and result share one slot, updated in place)\n"
"⍝ μ2 = A, unused (only reached for the monadic Z←LO⍣N B form)\n"
"⍝ μ3 = N  (C++ N, the repeat count), decremented once per iteration\n"
"⍝ μ4 = LO (C++ _LO), applied N times\n"
"⍝\n"
" μ1←μ4 μ1 ◊ 0 → 0<μ3←μ3-1\n")

/// dyadic power with repeat count and result
//
mac_def(  Z__A_LO_POWER_N_B,
" μ1←μ2 (μ4 μ¯16 μ3) μ1\n"
"⍝ called as Bif_OPER2_POWER::eval_ALRB(A, _LO, N, B) -- Z←A LO⍣N B\n"
"⍝\n"
"⍝ μ1 = B (C++ B; originally named Z on both sides of the header, so\n"
"⍝ accumulator and result share one slot)\n"
"⍝ μ2 = A  (C++ A), the fixed left argument of LO on every iteration\n"
"⍝ μ3 = N  (C++ N, the repeat count), decremented once per iteration\n"
"⍝ μ4 = LO (C++ _LO), applied N times\n"
"⍝\n"
"μ1←μ2 μ4 μ1 ◊ 0 → 0<μ3←μ3-1\n")

/// monadic power with condition function RO and no result
//
mac_def(  Z__LO_POWER_RO_B,
  " μ6←(μ4 μ¯17 μ5) μ1;μ7\n"
"⍝ called as Bif_OPER2_POWER::eval_LRB(_LO, _RO, B) -- Z←LO⍣RO B\n"
"⍝\n"
"⍝ μ1 = B  (C++ B), the previous value; overwritten with the new value\n"
"⍝ at the end of each iteration\n"
"⍝ μ4 = LO (C++ _LO), produces the next value\n"
"⍝ μ5 = RO (C++ _RO), the stop-condition function; iteration stops once\n"
"⍝ it returns 1\n"
"⍝ μ6 = Z, the new value (LO B); also the eventual result returned to\n"
"⍝ the C++ caller\n"
"⍝ μ7 = T, the condition result (Z RO B), local to the macro\n"
"⍝\n"
"μ6←μ4 μ1 ◊ μ7←μ6 μ5 μ1 ◊ μ1←μ6 ◊ 0 →(,μ7)≢,1\n")

/// monadic power with condition function RO and result
//
mac_def(  Z__A_LO_POWER_RO_B,
" μ6←μ2 (μ4 μ¯18 μ5) μ1;μ7\n"
"⍝ called as Bif_OPER2_POWER::eval_ALRB(A, _LO, _RO, B) -- Z←A LO⍣RO B\n"
"⍝\n"
"⍝ μ1 = B  (C++ B), the previous value; overwritten with the new value\n"
"⍝ at the end of each iteration\n"
"⍝ μ2 = A  (C++ A), the fixed left argument of LO on every iteration\n"
"⍝ μ4 = LO (C++ _LO), produces the next value\n"
"⍝ μ5 = RO (C++ _RO), the stop-condition function; iteration stops once\n"
"⍝ it returns 1\n"
"⍝ μ6 = Z, the new value (A LO B); also the eventual result returned\n"
"⍝ to the C++ caller\n"
"⍝ μ7 = T, the condition result (Z RO B), local to the macro\n"
"⍝\n"
"μ6←μ2 μ4 μ1 ◊ μ7←μ6 μ5 μ1 ◊ μ1←μ6 ◊ 0 → (,μ7)≢,1\n")

/// reduce: Z←LO/[X] B
//
mac_def(Z__LO_REDUCE_X4_B,
" μ6←(μ4 μ¯19) [μ3] μ1;μ7;μ8;μ9;μ10;μ11;μ12;μ13;μ14;μ15\n"
" ⍝ called as Bif_REDUCE::eval_LXB(tok_LO, X4, B); C++ builds\n"
" ⍝ X4 as (axis+⎕IO, B3.h(), B3.m(), B3.l()) -- precomputed there for speed\n"
" ⍝\n"
" ⍝ μ1 = B  (C++ B)\n"
" ⍝ μ3 = X4 (C++ X4), destructured below into just the axis number;\n"
" ⍝ H/M_max/L (X4's other 3 fields) get their own slots, see below\n"
" ⍝ μ4 = LO (C++ tok_LO), the reduce function\n"
" ⍝ μ6 = Z, the result returned to the C++ caller\n"
" ⍝ μ7 = B3, B reshaped to (H,M_max,L) -- before/reduce-axis/after\n"
" ⍝ sizes, local to the macro\n"
" ⍝ μ8 = T, the running reduced value, local to the macro\n"
" ⍝ μ9 = H (from X4), size of the dimensions before the reduce-axis\n"
" ⍝ μ10 = M, position within the reduce-axis (counts down), local\n"
" ⍝ μ11 = M_max (from X4), size of the reduce-axis\n"
" ⍝ μ12 = L (from X4), size of the dimensions after the reduce-axis\n"
" ⍝ μ13 = N, loop index over Z's (H,L) positions, local to the macro\n"
" ⍝ μ14 = I, index list ,⍳(H,L) (cartesian product of Z positions), local\n"
" ⍝ μ15 = I_max, loop limit, local to the macro\n"
" ⍝\n"
" (μ3 μ9 μ11 μ12)←μ3 ◊ μ7←(μ9 μ11 μ12)⍴μ1 ◊ μ15←⎕IO+⍴μ14←,⍳⍴μ6←(μ9, μ12)⍴0 ◊ μ13←⎕IO\n"
" (μ9 μ12)←⊃μ14[μ13] ◊ μ10←μ11-2 ◊ μ8←μ7[μ9;⎕IO+μ11-1;μ12]\n"
" μ8← ⊂(⊃μ7[μ9;⎕IO+μ10;μ12]) μ4 ⊃μ8 ◊  0 → 0≤μ10←μ10-1\n"
" μ6[μ9;μ12]←μ8                   ◊ ¯2 → μ15>μ13←μ13+1\n"
" μ6←((μ3≠⍳⍴⍴μ1)/⍴μ1)⍴μ6\n")

/// reduce N-wise: Z←A LO/[X] B with positive A
//
mac_def(   Z__pA_LO_REDUCE_X4_B,
" μ6←μ2 (μ4 μ¯20) [μ3] μ1;μ7;μ8;μ9;μ10;μ11;μ12;μ13;μ14;μ15;μ16;μ17;μ18\n"
" ⍝ called as Bif_REDUCE::eval_ALXB(A1, tok_LO, X4, B) --\n"
" ⍝ A LO/[axis] B, N-wise, A1>0. X4 built by C++ as (axis+⎕IO, ⍴Z,\n"
" ⍝ ⍴Z3, ⍴B3) -- precomputed there for speed\n"
" ⍝\n"
" ⍝ μ1 = B  (C++ B)\n"
" ⍝ μ2 = A1 (C++ A1), the (positive) N-wise window size\n"
" ⍝ μ3 = X4 (C++ X4), destructured below into just the axis number;\n"
" ⍝ ⍴Z/⍴Z3/⍴B3 (X4's other 3 fields) get their own slots, see below\n"
" ⍝ μ4 = LO (C++ tok_LO), the reduce function\n"
" ⍝ μ6 = Z, the result returned to the C++ caller\n"
" ⍝ μ7 = rho_B3 (from X4), shape to reshape B into\n"
" ⍝ μ8 = B3, B reshaped per rho_B3, local to the macro\n"
" ⍝ μ9 = rho_Z (from X4), the result's final shape (trailing reshape)\n"
" ⍝ μ10 = rho_Z3 (from X4), intermediate 3-part shape used to allocate Z\n"
" ⍝ μ11 = T, running reduced value across one window, local\n"
" ⍝ μ12 = H, 'before' index component of the current Z position, local\n"
" ⍝ μ13 = M, position counter walking one window (from A1+1 down), local\n"
" ⍝ μ14 = L, 'after' index component of the current Z position, local\n"
" ⍝ μ15 = a, index component along the reduce-axis, local\n"
" ⍝ μ16 = N, loop index over Z's flattened positions, local\n"
" ⍝ μ17 = I, index list ,⍳rho_Z3 (one 3-tuple (H,a,L) per Z pos), local\n"
" ⍝ μ18 = I_max, loop limit, local to the macro\n"
" ⍝\n"
" (μ3 μ9 μ10 μ7)←μ3 ◊ μ8←μ7⍴μ1 ◊ μ18←⎕IO+⍴μ17←,⍳⍴μ6←(μ10)⍴0 ◊ μ16←⎕IO\n"
" (μ12 μ15 μ14)←⊃μ17[μ16] ◊ μ13←μ2+1 ◊ μ11←μ8[μ12;μ15-μ2;μ14]\n"
" μ11← ⊂(⊃μ8[μ12;μ15-μ13;μ14]) μ4 ⊃μ11 ◊  0 → 0≥μ13←μ13+1\n"
" μ6[μ12;μ15;μ14]←μ11               ◊ ¯2 →μ18>μ16←μ16+1\n"
" μ6←μ9⍴μ6\n")

/// reduce N-wise: Z←A LO/[X] B with negative A
//
mac_def(   Z__nA_LO_REDUCE_X4_B,
" μ6←μ2 (μ4 μ¯21) [μ3] μ1;μ7;μ8;μ9;μ10;μ11;μ12;μ13;μ14;μ15;μ16;μ17;μ18\n"
" ⍝ called as Bif_REDUCE::eval_ALXB(A1, tok_LO, X4, B) --\n"
" ⍝ A LO/[axis] B, N-wise, A1<0. X4 built by C++ as (axis+⎕IO, ⍴Z,\n"
" ⍝ ⍴Z3, ⍴B3) -- precomputed there for speed\n"
" ⍝\n"
" ⍝ μ1 = B  (C++ B)\n"
" ⍝ μ2 = A1 (C++ A1), the (negative) N-wise window size\n"
" ⍝ μ3 = X4 (C++ X4), destructured below into just the axis number;\n"
" ⍝ ⍴Z/⍴Z3/⍴B3 (X4's other 3 fields) get their own slots, see below\n"
" ⍝ μ4 = LO (C++ tok_LO), the reduce function\n"
" ⍝ μ6 = Z, the result returned to the C++ caller\n"
" ⍝ μ7 = rho_B3 (from X4), shape to reshape B into\n"
" ⍝ μ8 = B3, B reshaped per rho_B3, local to the macro\n"
" ⍝ μ9 = rho_Z (from X4), the result's final shape (trailing reshape)\n"
" ⍝ μ10 = rho_Z3 (from X4), intermediate 3-part shape used to allocate Z\n"
" ⍝ μ11 = T, running reduced value across one window, local\n"
" ⍝ μ12 = H, 'before' index component of the current Z position, local\n"
" ⍝ μ13 = M, position counter walking one window (from ¯1 down to A1),\n"
" ⍝ local to the macro\n"
" ⍝ μ14 = L, 'after' index component of the current Z position, local\n"
" ⍝ μ15 = a, index component along the reduce-axis, local\n"
" ⍝ μ16 = N, loop index over Z's flattened positions, local\n"
" ⍝ μ17 = I, index list ,⍳rho_Z3 (one 3-tuple (H,a,L) per Z pos), local\n"
" ⍝ μ18 = I_max, loop limit, local to the macro\n"
" ⍝\n"
" (μ3 μ9 μ10 μ7)←μ3 ◊ μ8←μ7⍴μ1 ◊ μ18←⎕IO+⍴μ17←,⍳⍴μ6←(μ10)⍴0 ◊ μ16←⎕IO\n"
" (μ12 μ15 μ14)←⊃μ17[μ16] ◊ μ13←¯1 ◊ μ11←μ8[μ12;μ15;μ14]\n"
" μ11← ⊂((⊃μ8[μ12;μ15-μ13;μ14]) μ4 ⊃μ11) ◊  0 → μ2≤μ13←μ13-1\n"
" μ6[μ12;μ15;μ14]←μ11                 ◊ ¯2 →μ18>μ16←μ16+1\n"
" μ6←μ9⍴μ6\n")

/// scan: Z←LO/[X] B
//
mac_def(  Z__LO_SCAN_X4_B,
  " μ6←(μ4 μ¯22) [μ3] μ1;μ7;μ8;μ9;μ10;μ11;μ12;μ13;μ14;μ15;μ16\n"
"⍝ called as Bif_SCAN::eval_LXB(tok_LO, X4, B); C++ builds\n"
"⍝ X4 as (axis+⎕IO, Z3.h(), Z3.m(), Z3.l()) -- precomputed there for speed\n"
"⍝\n"
"⍝ μ1 = B  (C++ B)\n"
"⍝ μ3 = X4 (C++ X4), destructured below into just the axis number;\n"
"⍝ H/M_max/L (X4's other 3 fields) get their own slots, see below\n"
"⍝ μ4 = LO (C++ tok_LO), the scan function\n"
"⍝ μ6 = Z, the result (also B3's initial value, being B reshaped)\n"
"⍝ μ7 = B3 (from X4's H/M_max/L), B and Z reshaped to (H,M_max,L)\n"
"⍝ μ8 = T, running scanned value, local to the macro\n"
"⍝ μ9 = H (from X4), size of the dimensions before the scan-axis\n"
"⍝ μ10 = M, position within the scan-axis walked so far, local\n"
"⍝ μ11 = M_max (from X4), size of the scan-axis\n"
"⍝ μ12 = L (from X4), size of the dimensions after the scan-axis\n"
"⍝ μ13 = a, current position along the scan-axis, local to the macro\n"
"⍝ μ14 = N, loop index over Z's (H,M_max,L) positions, local\n"
"⍝ μ15 = I, index list ,⍳(H,M_max,L), local to the macro\n"
"⍝ μ16 = I_max, loop limit, local to the macro\n"
"⍝\n"
" (μ3 μ9 μ11 μ12)←μ3 ◊ μ16←⎕IO+⍴μ15←,⍳⍴μ6←μ7←(μ9 μ11 μ12)⍴μ1 ◊ μ14←⎕IO - 1\n"
" (μ9 μ13 μ12)←⊃μ15[μ14←μ14+1]          ◊  0 → μ13=⎕IO ◊ μ10←1 ◊ μ8←μ7[μ9;μ13;μ12]\n"
" μ8← ⊂((⊃μ7[μ9;μ13-μ10;μ12]) μ4 ⊃μ8) ◊  0 → μ13>μ10←μ10+1\n"
" μ6[μ9;μ13;μ12]←μ8                 ◊ ¯2 → μ16>μ14+1\n"
" μ6←(⍴μ1)⍴μ6\n")

/// rank: Z←  (LO⍤j) B and Z←  (LO⍤[X]j)
//
mac_def(Z__LO_RANK_X5_B,
 "μ6←(μ4 μ¯23) [μ3] μ1;μ7;μ8;μ9;μ10;μ11;μ12\n"
 "⍝ called as Bif_OPER2_RANK::eval_LXB(_LO, X5, B) -- (LO⍤j)B and\n"
 "⍝ (LO⍤[X]j)B. X5 built by C++ as (axis-or-¯1, LB, ⍴B, LZ, ⍴Z) --\n"
 "⍝ precomputed there for speed\n"
 "⍝\n"
 "⍝ μ1 = B  (C++ B), reshaped to (LZ,LB) below\n"
 "⍝ μ3 = X5 (C++ X5), destructured below into just the axis number\n"
 "⍝ (¯1 = no axis given)\n"
 "⍝ μ4 = LO (C++ _LO), applied to one rank-selected cell of B at a time\n"
 "⍝ μ6 = Z, the result returned to the C++ caller\n"
 "⍝ μ7 = LB  (from X5), ravelled length of one cell of B\n"
 "⍝ μ8 = rho_B (from X5), shape of one cell of B, used to reshape each\n"
 "⍝ cell before calling LO\n"
 "⍝ μ9 = N_max, loop limit, local to the macro\n"
 "⍝ μ10 = N, loop index over B's cells, local to the macro\n"
 "⍝ μ11 = LZ (from X5), number of cells (= the loop count)\n"
 "⍝ μ12 = rho_Z (from X5), the result's final shape (trailing reshape)\n"
 "⍝\n"
 " (μ3 μ7 μ8 μ11 μ12)←μ3 ◊ μ1←(μ11,μ7)⍴μ1 ◊ μ9←μ11+μ10←⎕IO ◊ μ6←μ11⍴0\n"
 " μ6[μ10]←⊂μ4 μ8⍴μ1[μ10;] ◊ 0 → μ9>μ10←μ10+1\n"
 "1 → μ3≢¯1 ◊ μ6←30 ⎕CR μ12⍴μ6 ◊ →0\n"
 " μ6←⊃[μ3]μ12⍴μ6\n")

/// rank: Z←A (LO⍤j) B and Z←(A LO⍤[X]j)
//
mac_def(  Z__A_LO_RANK_X7_B,
 " μ6←μ2 (μ4 μ¯24)[μ3] μ1;μ7;μ8;μ9;μ10;μ11;μ12;μ13;μ14\n"
 "⍝ called as Bif_OPER2_RANK::eval_ALXB(A, _LO, X7, B) -- A(LO⍤j)B\n"
 "⍝ and A(LO⍤[X]j)B. X7 built by C++ as (axis-or-¯1, LA, ⍴A, LB, ⍴B,\n"
 "⍝ LZ, ⍴Z) -- precomputed there for speed\n"
 "⍝\n"
 "⍝ μ1 = B  (C++ B), reshaped to (LZ,LB) below\n"
 "⍝ μ2 = A  (C++ A), reshaped to (LZ,LA) below\n"
 "⍝ μ3 = X7 (C++ X7), destructured below into just the axis number\n"
 "⍝ (¯1 = no axis given)\n"
 "⍝ μ4 = LO (C++ _LO), applied to one rank-selected cell of A and B\n"
 "⍝ μ6 = Z, the result returned to the C++ caller\n"
 "⍝ μ7 = LA  (from X7), ravelled length of one cell of A\n"
 "⍝ μ8 = rho_A (from X7), shape of one cell of A, reshaped before LO\n"
 "⍝ μ9 = LB  (from X7), ravelled length of one cell of B\n"
 "⍝ μ10 = rho_B (from X7), shape of one cell of B, reshaped before LO\n"
 "⍝ μ11 = N_max, loop limit, local to the macro\n"
 "⍝ μ12 = N, loop index over A's/B's cells, local to the macro\n"
 "⍝ μ13 = LZ (from X7), number of cells (= the loop count)\n"
 "⍝ μ14 = rho_Z (from X7), the result's final shape (trailing reshape)\n"
 "⍝\n"
 " (μ3 μ7 μ8 μ9 μ10 μ13 μ14)←μ3 ◊ μ2←(μ13,μ7)⍴μ2 ◊ μ1←(μ13,μ9)⍴μ1\n"
 " μ11←μ13+μ12←⎕IO ◊ μ6←μ13⍴0\n"
 " μ6[μ12]←⊂(μ8⍴μ2[μ12;]) μ4 μ10⍴μ1[μ12;] ◊ 0 → μ11>μ12←μ12+1\n"
 "1 → μ3≢¯1 ◊ μ6←30 ⎕CR μ14⍴μ6 ◊ →0\n"
 " μ6←⊃[μ3]μ14⍴μ6\n")

/// ⎕INP helper
//
mac_def(Z__Quad_INP_B,
    " μ1←μ¯25 μ1;μ6;μ7;μ8;μ9;μ10\n"
"⍝ called as Quad_INP::eval_AB(A, B): eval_B(BB), where BB is the\n"
"⍝ per-line text array (each element a 3-part row) assembled by ⎕INP\n"
"⍝ in C++\n"
"⍝\n"
"⍝ μ1 = B (C++ BB; originally named B on both sides of the header, so\n"
"⍝ input and result share one slot, one row rewritten in place at a time)\n"
"⍝ μ6 = C, column index while scanning one row for a leading dot\n"
"⍝ (⎕IO-based, offset by ¯1), local to the macro\n"
"⍝ μ7 = C_max, column-scan limit for the current row, local to the macro\n"
"⍝ μ8 = N, loop index over B's rows, local to the macro\n"
"⍝ μ9 = N_max, loop limit, local to the macro\n"
"⍝ μ10 = ROW, current row of B being rewritten, local to the macro\n"
"⍝\n"
" μ8←⎕IO ◊ μ9←μ8+↑(⍴μ1),1\n"
" μ10←⊃μ1[μ8] ◊ μ6←¯1+⎕IO ◊ μ7←μ6+⎕IO+⍴μ10 ◊ 2 → 1\n"
" μ10[μ6]←⊂⍕⍎⊃μ10[μ6]\n"
" ¯1 → μ7>μ6←μ6+2 ◊ μ1[μ8]←31 ⎕CR ⊂μ10 ◊ ¯2 → μ9>μ8←μ8+1\n")

/// ⎕EA (Execute Alternate) helper
//
mac_def(Z__A_Quad_EA_B,
  " μ6←μ2 μ¯26 μ1;μ7;μ8;μ9\n"
"⍝ called as Quad_EA::eval_AB(A, B)\n"
"⍝\n"
"⍝ μ1 = B  (C++ B), the APL expression text to execute\n"
"⍝ μ2 = A  (C++ A), ⎕EA's alternate-branch payload, forwarded to ⎕ES\n"
"⍝ on the →N/error/escape paths\n"
"⍝ μ6 = Z, the result returned to the C++ caller\n"
"⍝ μ7 = RC, ⎕EC's return code (0=error,1/2=value,3=no value/→N out\n"
"⍝ of range,4/5=syntax error), local to the macro\n"
"⍝ μ8 = ET, ⎕EC's error token (meaningful only when RC=0), local\n"
"⍝ μ9 = RES, ⎕EC's result value (meaningful only when RC=1 or 2), local\n"
"⍝\n"
"     (μ7 μ8 μ9)←⎕EC μ1 ◊ 1→μ7=0 ◊ 2→μ7=1 ◊ 3→μ7=2 ◊ →(μ7=3)/0 ◊ 4→μ7=4 ◊ 5→μ7=5\n"
" ⎕ES 100 $FFFF,  (⊂,μ2),  μ8     ⍝ error\n"
" μ6←μ9      ◊ →0                ⍝ non-committed value\n"
" ⎕ES 100 $FFFE   μ9            ⍝ committed value\n"
  // A is added to BRA's payload (unlike the original, RES-only form)
  // so that handle_QUAD_ES_BRA() (Prefix.cc) can fall back to
  // executing A itself when the →N in B turns out to be out of range
  // for ⎕EA's caller too (lrm p.349 Figure 38: "0 or any other line
  // number not within the function... flow of execution returns to
  // the invoking expression" -- i.e. B "failed" from ⎕EA's own point
  // of view, same as if it had errored; a →N that IS within the
  // caller's own range is simply taken directly, A never enters into
  // it -- see Blake McBride, LanguageVariances.md #27).
" ⎕ES 100 $FFFD,  (⊂,μ2),  μ9    ⍝ →N\n"
" ⎕ES 100 $FFFC                  ⍝ →\n")

/// ⎕EB (Execute Both) helper
//
mac_def(Z__A_Quad_EB_B,
  " μ6←μ2 μ¯27 μ1;μ7;μ8;μ9\n"
"⍝ called as Quad_EB::eval_AB(A, B)\n"
"⍝\n"
"⍝ μ1 = B  (C++ B), the alternate APL expression text, evaluated via ⎕EC\n"
"⍝ μ2 = A  (C++ A), the primary APL expression text, ⍎'d directly first\n"
"⍝ μ6 = Z, the result returned to the C++ caller\n"
"⍝ μ7 = RC, ⎕EC's return code, local to the macro\n"
"⍝ μ8 = ET, ⎕EC's error token (meaningful only when RC=0), local\n"
"⍝ μ9 = RES, ⎕EC's result value (meaningful only when RC=1 or 2), local\n"
"⍝\n"
"     (μ7 μ8 μ9)←⎕EC μ1 ◊ ⍎μ2\n"
"     1→μ7=0 ◊ 2→μ7=1 ◊ 3→μ7=2 ◊ →(μ7=3)/0 ◊ 4→μ7=4 ◊ 5→μ7=5\n"
" ⎕ES μ8     ◊ →0                ⍝ error\n"
" μ6←μ9      ◊ →0                ⍝ non-committed value\n"
" ⎕ES 100 $FFFE   μ9            ⍝ committed value\n"
" ⎕ES 100 $FFFD   μ9            ⍝ →N\n"
" ⎕ES 100 $FFFC                  ⍝ →\n")

/// inner product with A and B of rank ≤ 1
//
mac_def(  Z__vA_LO_INNER_RO_vB,
 "μ6←μ2 (μ4 μ¯28 μ5) μ1\n"
 "⍝ called as Bif_OPER2_INNER::eval_ALRB(A, _LO, _RO, B) -- A and B\n"
 "⍝ both rank ≤ 1\n"
 "⍝\n"
 "⍝ μ1 = B  (C++ B)\n"
 "⍝ μ2 = A  (C++ A)\n"
 "⍝ μ4 = LO (C++ _LO), the reduce function\n"
 "⍝ μ5 = RO (C++ _RO), the elementwise function\n"
 "⍝ μ6 = Z, the result returned to the C++ caller\n"
 "⍝\n"
 "μ6←μ4/(,μ2) μ5 ,μ1\n")

/// monadic EACH with ⍎
//
mac_def(Z__EXEC_EACH_B,
 "μ6← μ¯29 μ1;μ7;μ8;μ9;μ10;μ11;μ12;μ13;μ14;μ15;μ16\n"
 "⍝ called as Bif_OPER1_EACH::eval_B(B) -- ⍎¨B, i.e. LO is ⍎ itself\n"
 "⍝\n"
 "⍝ μ1 = B  (C++ B), a vector of APL expression texts, ravelled in place\n"
 "⍝ μ6 = Z, the result returned to the C++ caller\n"
 "⍝ μ7 = T, per-element results collected so far (same shape as B), local\n"
 "⍝ μ8 = rho_Z, B's original shape, used for the trailing reshape, local\n"
 "⍝ μ9 = RC, ⎕EC's return code for the current element, local\n"
 "⍝ μ10 = ET, ⎕EC's error token for the current element (meaningful\n"
 "⍝ only when RC=0), local to the macro\n"
 "⍝ μ11 = ZZ, ⎕EC's result value for the current element (meaningful\n"
 "⍝ only when RC=1 or 2), local to the macro\n"
 "⍝ μ12 = J, relative-offset branch-distance table indexed by RC,\n"
 "⍝ replacing the former RC0/RC12/RC3/RC4/RC5 labels, local to the macro\n"
 "⍝ μ13 = N, loop index over B's elements, local to the macro\n"
 "⍝ μ14 = N3, count of elements that returned a value (RC 1 or 2), local\n"
 "⍝ μ15 = V3, count of elements that returned no value (RC 3), local\n"
 "⍝ μ16 = N_max, loop limit, local to the macro\n"
 "⍝\n"
 " μ13←⎕IO ◊ μ8←⍴μ1 ◊ μ16←μ13+⍴μ1←,μ1 ◊ μ7←(⍴μ1)⍴0 ◊ μ15←μ14←⎕IO\n"
 " μ12←1,2,2,3,4,5\n"
 " (μ9 μ10 μ11)←⎕EC ⊃μ1[μ13] ◊ μ12[⎕IO+μ9] → 1\n"
 " ((⊃μ11)[⎕IO;], ' in macro ⍎¨') ⎕ES ⊃μ10\n"
 " μ7[μ13]←⊂μ11 ◊ μ14←μ14+1 ◊ ¯2 → μ16>μ13←μ13+1 ◊ 4 → 1\n"
 " μ15←μ15+1 ◊ ¯3 → μ16>μ13←μ13+1 ◊ 3 → 1\n"
 " 'SYNTAX ERROR: →N in macro ⍎¨' ⎕ES 2 2\n"
 " 'SYNTAX ERROR: → in macro ⍎¨'  ⎕ES 2 2\n"
 " →(μ15=μ16)⍴0                      ⍝ NO RESULT\n"
 " 2 → μ14≠μ16 ◊ μ6←μ8⍴μ7 ◊ →0\n  ⍝ RESULT\n"
 "'VALUE ERROR in macro ⍎¨' ⎕ES 3 1\n")

#undef mac_def

/// \endcond
