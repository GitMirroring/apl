//──────────────────────────────────────────────────────────────────────────
void
Value::depth_update_for_overwrite(ShapeItem offset, int new_sub_depth)
// Update the depth cache when ravel[offset] is about to be overwritten.
// new_sub_depth: -1 = new cell is simple; >=0 = PointerCell to sub of that depth.
// Call BEFORE the actual write.
// Only Simple→Simple is a safe no-op; any PointerCell involvement marks dirty,
// because sub-value depth may change later (no parent pointers to propagate).
{
   if (flags.value_depth == VF_DEPTH_DIRTY)   return;   // already dirty
   if (!get_cravel(offset).is_pointer_cell() && new_sub_depth < 0)
      return;   // Simple → Simple: depth cannot change
   flags.value_depth = VF_DEPTH_DIRTY;
}
//──────────────────────────────────────────────────────────────────────────
void
Value::next_ravel_Pointer(Value * value)
{
   flags.value_depth = VF_DEPTH_DIRTY;
   Assert(!value->is_simple_scalar());
   new (next_ravel()) PointerCell(value, *this);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::next_ravel_Pointer(Value * value, uint32_t magic)
{
   flags.value_depth = VF_DEPTH_DIRTY;
   Assert(!value->is_simple_scalar());
   new (next_ravel()) PointerCell(value, *this, magic);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::next_ravel_Value(Value * value)
{
   // A *scalar* value (simple OR nested, e.g. ⊂1 2 3) already fits into a
   // single ravel cell as-is -- reuse its own sole cell (next_ravel_Cell
   // handles both the copy and the depth-dirty marking for a nested cell).
   // Only a genuine non-scalar (rank >= 1) needs a fresh PointerCell to be
   // boxed into one cell. The previous is_simple_scalar() check missed the
   // nested-scalar case, wrapping it in a *second*, redundant PointerCell:
   // confirmed directly (1 (⊂1 2 3) 2 stored position 2 as pointer→(⊂1 2 3)
   // instead of pointer→(1 2 3), so 2⊃(1 (⊂1 2 3) 2) came back still boxed
   // -- depth 2 instead of 1 -- while 1 (1 2 3) 2, without the explicit ⊂,
   // was unaffected). This is the vector/strand-literal construction path
   // (Parser::create_vector_value), so the bug affects any "A (⊂X) B"
   // strand with non-scalar X -- a common way to explicitly box a value
   // for a nested array literal.
   //
   if (value->is_scalar())
      next_ravel_Cell(value->get_cfirst());
   else
      {
        flags.value_depth = VF_DEPTH_DIRTY;
        new (next_ravel()) PointerCell(value, *this);
      }
}
//──────────────────────────────────────────────────────────────────────────
void
Value::next_ravel_Lval(Cell * target, Value * target_owner)
{
  new (next_ravel()) LvalCell(target, target_owner);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::next_ravel_Cell(const Cell & other)
{
   if (other.is_pointer_cell())   flags.value_depth = VF_DEPTH_DIRTY;
   other.init_other(next_ravel(), *this, LOC);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::next_ravel_Proto(const Cell & cell)
{
  next_ravel()->init_type(cell, *this, LOC);
}
//──────────────────────────────────────────────────────────────────────────
//──────────────────────────────────────────────────────────────────────────
void
Value::set_ravel_Char(ShapeItem offset, Unicode uni)
{
   depth_update_for_overwrite(offset, -1);
   new (&get_wravel(offset))   CharCell(uni);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::set_ravel_Int(ShapeItem offset, APL_Integer aint)
{
   depth_update_for_overwrite(offset, -1);
   new (&get_wravel(offset))   IntCell(aint);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::set_ravel_Float(ShapeItem offset, APL_Float flt)
{
   depth_update_for_overwrite(offset, -1);
   new (&get_wravel(offset))   FloatCell(flt);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::set_ravel_Complex(ShapeItem offset, APL_Float real, APL_Float imag)
{
   depth_update_for_overwrite(offset, -1);
   new (&get_wravel(offset))   ComplexCell(real, imag);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::set_ravel_Cell(ShapeItem offset, const Cell & cell)
{
   depth_update_for_overwrite(offset, cell.is_pointer_cell() ? 0 : -1);
   get_wravel(offset).init(cell, *this, LOC);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::set_ravel_Pointer(ShapeItem offset, Value * value)
{
   Assert(!value->is_simple_scalar());
   depth_update_for_overwrite(offset, 0);   // PointerCell → dirty
   new (&get_wravel(offset))   PointerCell(value, *this);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::set_ravel_Value(ShapeItem offset, Value * value)
{
   if (value->is_simple_scalar())
      {
        depth_update_for_overwrite(offset, -1);
        get_wravel(offset).init(value->get_cfirst(), *this, LOC);
      }
   else
      {
        depth_update_for_overwrite(offset, 0);   // PointerCell → dirty
        new (&get_wravel(offset)) PointerCell(value, *this);
      }
}
//════════════════════════════════════════════════════════════════════════════
const int64_t *
Value::fetch_ravel_i64(ShapeItem i) const
{
   switch (get_ravel_type())
      {
        case RPT_BOOL:
             ravel.fetch_cache =
                  (reinterpret_cast<const int64_t *>(ravel.cells)[i >> 6]
                      >> (i & 63)) & 1;
             return &ravel.fetch_cache;
        case RPT_UNICODE16:
             ravel.fetch_cache =
                  reinterpret_cast<const uint16_t *>(ravel.cells)[i];
             return &ravel.fetch_cache;
        case RPT_UNICODE32:
             ravel.fetch_cache =
                  reinterpret_cast<const Unicode *>(ravel.cells)[i];
             return &ravel.fetch_cache;
        case RPT_INT64:
        case RPT_FLOAT64:
             return reinterpret_cast<const int64_t *>(ravel.cells) + i;
        case RPT_COMPLEX:
             return reinterpret_cast<const int64_t *>(ravel.cells) + (i << 1);
        default:   // RPT_CELLS
             return reinterpret_cast<const int64_t *>(
                        reinterpret_cast<const char *>(&ravel.cells[i]) + 8);
      }
}
//──────────────────────────────────────────────────────────────────────────
int64_t *
Value::wfetch_ravel_i64(ShapeItem i)
{
   switch (get_ravel_type())
      {
        case RPT_BOOL:
             return reinterpret_cast<int64_t *>(ravel.cells) + (i >> 6);
        case RPT_UNICODE16:
             return reinterpret_cast<int64_t *>(ravel.cells) + (i >> 2);
        case RPT_UNICODE32:
             return reinterpret_cast<int64_t *>(ravel.cells) + (i >> 1);
        case RPT_INT64:
        case RPT_FLOAT64:
             return reinterpret_cast<int64_t *>(ravel.cells) + i;
        case RPT_COMPLEX:
             return reinterpret_cast<int64_t *>(ravel.cells) + (i << 1);
        default:   // RPT_CELLS
             return reinterpret_cast<int64_t *>(
                        reinterpret_cast<char *>(&ravel.cells[i]) + 8);
      }
}
//════════════════════════════════════════════════════════════════════════════
#endif // __VALUE_ICC_DEFINED__
